{
  "name": "osakenomitai-app",
  "private": true,
  "description": "オサケノミタイを App Store と Google Play に出すためのアプリ（Capacitor）",
  "scripts": {
    "web": "node copy-web.mjs",
    "sync": "node copy-web.mjs && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.3"
  }
}
