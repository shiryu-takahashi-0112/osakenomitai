rules_version = '2';

// オサケノミタイ地図のFirestoreルール。
// 反映はFirebaseコンソール（osakenomitai-map → Firestore → ルール）に、このファイルの中身をそのまま貼って公開する。
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者（Shiryu）。投稿された店を消すときに使う
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'shiryu.takahashi.112@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 保存・閲覧履歴・行った店など、本人だけが読み書きするデータ
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ユーザーが投稿した酒場。誰でも見られ、ログインした人が投稿できる（すぐ公開）
    function validShop(d) {
      return d.keys().hasOnly(['name', 'area', 'cat', 'addr', 'walk', 'price', 'hours', 'closed', 'desc',
                               'lat', 'lng', 'ig', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.area is string && d.area.size() > 0 && d.area.size() <= 30
        && d.cat in ['izakaya', 'sakaya', 'bar']
        && d.addr is string && d.addr.size() > 0 && d.addr.size() <= 120
        && d.lat is number && d.lat > 20 && d.lat < 46
        && d.lng is number && d.lng > 122 && d.lng < 154
        && (!('walk' in d) || (d.walk is string && d.walk.size() <= 60))
        && (!('price' in d) || (d.price is string && d.price.size() <= 40))
        && (!('hours' in d) || (d.hours is string && d.hours.size() <= 200))
        && (!('closed' in d) || (d.closed is string && d.closed.size() <= 60))
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 200))
        && (!('ig' in d) || (d.ig is string && d.ig.size() <= 300 && d.ig.matches('^https://www[.]instagram[.]com/.*')))
        && d.createdByName is string && d.createdByName.size() <= 60;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validShop(request.resource.data);
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validShop(request.resource.data);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    // 店の評価。1人1店1件（ドキュメントIDは「店のID_ユーザーのuid」に固定）。誰でも見られる
    function validReview(d, reviewId) {
      return d.keys().hasOnly(['shopId', 'uid', 'userName', 'rating', 'comment', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.shopId is string && d.shopId.size() > 0 && d.shopId.size() <= 40
        && reviewId == d.shopId + '_' + request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
        && d.userName is string && d.userName.size() <= 60
        && d.updatedAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && validReview(request.resource.data, reviewId)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validReview(request.resource.data, reviewId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
